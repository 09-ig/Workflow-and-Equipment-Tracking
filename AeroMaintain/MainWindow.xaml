<Window x:Class="AeroMaintain.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="AeroMaintain"
        Height="860"
        Width="1320"
        MinHeight="760"
        MinWidth="1160"
        Loaded="Window_Loaded"
        Background="#F2F1ED"
        FontFamily="Bahnschrift">
    <Window.Resources>
        <SolidColorBrush x:Key="GraphiteBrush" Color="#2F3438" />
        <SolidColorBrush x:Key="SlateBrush" Color="#5A656E" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FCFBF8" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#D6D2C8" />
        <SolidColorBrush x:Key="HealthyBrush" Color="#5E7D63" />
        <SolidColorBrush x:Key="WatchBrush" Color="#B48B40" />
        <SolidColorBrush x:Key="CriticalBrush" Color="#A2524B" />
        <SolidColorBrush x:Key="SteelBlueBrush" Color="#5A7388" />
        <SolidColorBrush x:Key="OliveBrush" Color="#6E7852" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6B6E6F" />

        <Style x:Key="PanelStyle" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource GraphiteBrush}" />
        </Style>

        <Style x:Key="SecondaryTextStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#E5E1D8" />
            <Setter Property="BorderBrush" Value="#C7C1B4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource GraphiteBrush}" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="#F3F0E8" FontSize="28" FontWeight="SemiBold">
                        AeroMaintain
                    </TextBlock>
                    <TextBlock Foreground="#D5D8DB" FontSize="13">
                        Smart maintenance workflow and equipment health tracker for practical industrial operations.
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Foreground="#D5D8DB" FontSize="12">
                        Snapshot Date
                    </TextBlock>
                    <TextBlock Foreground="#F3F0E8" FontSize="18" FontWeight="SemiBold" Text="{Binding TodayLabel}" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="16" Background="#F2F1ED" BorderThickness="0">
            <TabItem Header="Operations Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Fleet Snapshot" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,14"
                                   Text="A quick daily view for what is healthy, what needs watching, and what needs action now." />

                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,14">
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Healthy Units" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource HealthyBrush}" Text="{Binding HealthyCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Watchlist Units" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource WatchBrush}" Text="{Binding WatchCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Critical Units" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" Text="{Binding CriticalCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Overdue Tasks" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource CriticalBrush}" Text="{Binding OverdueCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,10,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Upcoming (30 Days)" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource SteelBlueBrush}" Text="{Binding UpcomingCount}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Average Health Score" />
                                    <TextBlock FontSize="34" FontWeight="SemiBold" Foreground="{StaticResource OliveBrush}" Text="{Binding AverageHealthScoreText}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.1*" />
                                <ColumnDefinition Width="1.9*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GraphiteBrush}" Text="Fleet Distribution" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"
                                               Text="A simple visual tally for status balance." />

                                    <TextBlock Text="Healthy" />
                                    <ProgressBar Height="18" Margin="0,4,0,10" Maximum="{Binding ProgressMax}" Value="{Binding HealthyCount}" Foreground="{StaticResource HealthyBrush}" />

                                    <TextBlock Text="Watch" />
                                    <ProgressBar Height="18" Margin="0,4,0,10" Maximum="{Binding ProgressMax}" Value="{Binding WatchCount}" Foreground="{StaticResource WatchBrush}" />

                                    <TextBlock Text="Critical" />
                                    <ProgressBar Height="18" Margin="0,4,0,0" Maximum="{Binding ProgressMax}" Value="{Binding CriticalCount}" Foreground="{StaticResource CriticalBrush}" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                                <StackPanel>
                                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource GraphiteBrush}" Text="Priority Queue" />
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"
                                               Text="Items here are either overdue or currently marked critical." />

                                    <DataGrid ItemsSource="{Binding AtRiskTasks}" AutoGenerateColumns="False" Height="250"
                                              CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal" BorderBrush="#CBC6BA">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentName}" Width="*" />
                                            <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="120" />
                                            <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="120" />
                                            <DataGridTextColumn Header="Days" Binding="{Binding DaysRemaining}" Width="70" />
                                            <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLabel}" Width="110" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                                               Text="{Binding AtRiskNote}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Equipment Registry">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Add / Update Equipment" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,12"
                                       Text="Use realistic tags and intervals. Clear labels now avoid maintenance confusion later." />

                            <TextBlock Text="Equipment Name" />
                            <TextBox x:Name="NameTextBox" Margin="0,4,0,8" />

                            <TextBlock Text="Serial Number" />
                            <TextBox x:Name="SerialTextBox" Margin="0,4,0,8" />

                            <TextBlock Text="Category" />
                            <ComboBox x:Name="CategoryComboBox" Margin="0,4,0,8" SelectedIndex="0">
                                <ComboBoxItem Content="Engine" />
                                <ComboBoxItem Content="Generator" />
                                <ComboBoxItem Content="Pump" />
                                <ComboBoxItem Content="Compressor" />
                                <ComboBoxItem Content="Turbine" />
                                <ComboBoxItem Content="Hydraulic System" />
                                <ComboBoxItem Content="Control Panel" />
                            </ComboBox>

                            <TextBlock Text="Last Maintenance Date" />
                            <DatePicker x:Name="LastMaintenanceDatePicker" Margin="0,4,0,8" />

                            <TextBlock Text="Maintenance Interval (Days)" />
                            <TextBox x:Name="IntervalTextBox" Margin="0,4,0,8" />

                            <TextBlock Text="Current Status" />
                            <ComboBox x:Name="StatusComboBox" Margin="0,4,0,8" SelectedIndex="0">
                                <ComboBoxItem Content="Healthy" />
                                <ComboBoxItem Content="Watch" />
                                <ComboBoxItem Content="Critical" />
                            </ComboBox>

                            <TextBlock Text="Recent Issue Count (0-10)" />
                            <TextBox x:Name="IssueCountTextBox" Margin="0,4,0,8" />

                            <TextBlock Text="Notes (Optional)" />
                            <TextBox x:Name="NotesTextBox" Margin="0,4,0,12" Height="70" TextWrapping="Wrap" AcceptsReturn="True" />

                            <WrapPanel Margin="0,4,0,0">
                                <Button Content="Save Equipment" Click="SaveEquipmentButton_Click" />
                                <Button Content="Clear Form" Click="ClearFormButton_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Delete Selected" Click="DeleteSelectedButton_Click" />
                                <Button Content="Persist to JSON" Click="PersistButton_Click" />
                            </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <Button Content="Mark Maintained (Today)" Click="MarkMaintainedButton_Click" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0"
                                       Text="{Binding RegistryNote}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Registered Fleet" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"
                                       Text="Tip: select any row to edit details and preserve audit-friendly naming conventions." />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Filter by name, serial number, or category" />
                                <Button Content="Clear" Click="ClearSearchButton_Click" Margin="8,0,0,0" />
                            </StackPanel>

                            <DataGrid x:Name="EquipmentDataGrid"
                                      ItemsSource="{Binding EquipmentItems}"
                                      SelectedItem="{Binding SelectedEquipment}"
                                      SelectionChanged="EquipmentDataGrid_SelectionChanged"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      Height="520"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      BorderBrush="#CBC6BA">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="110" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120" />
                                    <DataGridTextColumn Header="Last Maint." Binding="{Binding LastMaintenanceDate, StringFormat=yyyy-MM-dd}" Width="110" />
                                    <DataGridTextColumn Header="Interval" Binding="{Binding MaintenanceIntervalDays}" Width="80" />
                                    <DataGridTextColumn Header="Next Due" Binding="{Binding NextDueDate, StringFormat=yyyy-MM-dd}" Width="105" />
                                    <DataGridTemplateColumn Header="Status" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Padding="6,2" CornerRadius="10" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="#D8DFD9" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Watch">
                                                                    <Setter Property="Background" Value="#E9D7A5" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Critical">
                                                                    <Setter Property="Background" Value="#E7C0BC" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Status}" FontSize="12" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Issues" Binding="{Binding RecentIssueCount}" Width="65" />
                                    <DataGridTextColumn Header="Score" Binding="{Binding HealthScore}" Width="65" />
                                    <DataGridTextColumn Header="Label" Binding="{Binding HealthLabel}" Width="170" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                                       Text="{Binding FleetEmptyState}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Maintenance Scheduler">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Task Horizon" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"
                                           Text="Filter by status and due window to prepare daily or weekly maintenance runs." />
                            </StackPanel>
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Status</TextBlock>
                                <ComboBox x:Name="SchedulerStatusFilterComboBox" Width="120" Margin="0,0,10,0"
                                          ItemsSource="{Binding StatusFilterOptions}" SelectedItem="{Binding SelectedStatusFilter}"
                                          SelectionChanged="SchedulerFilter_SelectionChanged" />
                                <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">Due</TextBlock>
                                <ComboBox x:Name="SchedulerDueFilterComboBox" Width="150" Margin="0,0,10,0"
                                          ItemsSource="{Binding DueFilterOptions}" SelectedItem="{Binding SelectedDueFilter}"
                                          SelectionChanged="SchedulerFilter_SelectionChanged" />
                                <Button Content="Export Tasks CSV" Click="ExportTasksCsvButton_Click" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding FilteredTasks}" AutoGenerateColumns="False"
                                      CanUserAddRows="False" IsReadOnly="True" Height="560"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#CBC6BA">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter Property="Background" Value="#F4DFDC" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Equipment" Binding="{Binding EquipmentName}" Width="*" />
                                    <DataGridTextColumn Header="Serial" Binding="{Binding SerialNumber}" Width="120" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="130" />
                                    <DataGridTextColumn Header="Due Date" Binding="{Binding DueDate, StringFormat=yyyy-MM-dd}" Width="120" />
                                    <DataGridTextColumn Header="Days Remaining" Binding="{Binding DaysRemaining}" Width="110" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding EquipmentStatus}" Width="95" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding PriorityLabel}" Width="110" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0"
                                       Text="{Binding SchedulerNote}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Guided Troubleshooting">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelStyle}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Symptom Lookup" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,12"
                                       Text="Rule-based guidance only. This helps standardize first-pass checks before escalation." TextWrapping="Wrap" />

                            <TextBlock Text="Select Symptom" />
                            <ComboBox x:Name="SymptomComboBox" Margin="0,4,0,10"
                                      ItemsSource="{Binding SymptomOptions}"
                                      SelectionChanged="SymptomComboBox_SelectionChanged" />

                            <TextBlock FontSize="13" Foreground="{StaticResource MutedTextBrush}"
                                       Text="Common symptom set: overheating, vibration, delayed startup, abnormal noise, sensor warning." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}" Text="{Binding SelectedSymptomTitle}" />

                            <Border Grid.Row="1" BorderThickness="1" BorderBrush="#D2CEC2" CornerRadius="4" Padding="10" Margin="0,12,0,8">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GraphiteBrush}" Text="Possible Causes" />
                                    <ItemsControl ItemsSource="{Binding PossibleCauses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="2" BorderThickness="1" BorderBrush="#D2CEC2" CornerRadius="4" Padding="10" Margin="0,8,0,0">
                                <StackPanel>
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource GraphiteBrush}" Text="Recommended Checks" />
                                    <ItemsControl ItemsSource="{Binding RecommendedChecks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reports and Export">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                        <WrapPanel>
                            <Button Content="Export Equipment CSV" Click="ExportEquipmentCsvButton_Click" />
                            <Button Content="Generate Text Report" Click="GenerateReportButton_Click" />
                            <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{Binding LastExportMessage}" TextWrapping="Wrap" />
                        </WrapPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Latest Report Preview" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,10"
                                       Text="Use this summary in standups or shift handovers. Full report is saved under /Exports." />
                            <TextBox Text="{Binding ReportPreview}" IsReadOnly="True" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="560" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
